

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      String   @default("CUSTOMER")
}

model Admin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id            String   @id @default(uuid())
  ticketNumber  String   @unique
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  passengerName String
  phoneNumber   String
  mpesaRefCode  String?
  route         String
  travelDate    String
  seats         Int
  amount        Float    @default(0.0)
  status        String   @default("CONFIRMED")
  createdAt     DateTime @default(now())
}

model Booking {
  id                String   @id @default(uuid())
  userId            String?
  email             String?
  checkoutRequestId String?
  serviceType       String
  firstName         String
  lastName          String
  startingPoint     String
  destination       String
  travelDate        String
  seats             Int      @default(1)
  carType           String?
  paymentType       String
  mpesaNumber       String?
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  ticket            Ticket?
}

model Service {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Route {
  id            String   @id @default(uuid())
  startingPoint String
  destination   String
  price         Float
  serviceType   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Vehicle {
  id          String   @id @default(uuid())
  name        String
  plate       String   @unique
  serviceType String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CommunityMember {
  id        String   @id @default(uuid())
  email     String   @unique
  status    String   @default("subscribed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
